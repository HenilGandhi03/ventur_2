# Copy to .env and adjust. All values are optional; sensible defaults apply.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

API_PREFIX=/api/v1

# Comma-separated allowed origins in production, e.g. https://app.example.com
# Leave as * to allow all (fine for local dev).
CORS_ORIGINS=*

# Pagination guards
PAGE_DEFAULT_LIMIT=20
PAGE_MAX_LIMIT=100

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Data locations (relative to server/)
LEVELS_SEED_PATH=data/levels.seed.json
PROGRESS_STORE_PATH=data/progress.json

# Width (px) requested from image CDNs
IMAGE_WIDTH=1000
